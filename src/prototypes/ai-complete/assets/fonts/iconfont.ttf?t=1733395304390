	function deserializeEnvConfig(configStr) {
		try {
			// 清理可能的控制字符，但保留换行符和制表符
			var cleanConfigStr = configStr.replace(/[\x00-\x08\x0B\x0C\x0E-\x1F\x7F]/g, '');
			
			return JSON.parse(cleanConfigStr, function(key, value) {
				if (value && typeof value === 'object' && value.__type) {
					if (value.__type === 'RegExp') {
						return new RegExp(value.source, value.flags);
					}
					if (value.__type === 'Function') {
						// 使用 Function 构造函数重建函数
						// 注意：这里假设函数是纯函数，不依赖外部作用域
						try {
							return new Function('return ' + value.source)();
						} catch (e) {
							console.warn('Failed to deserialize function:', e);
							return null;
						}
					}
				}
				return value;
			});
		} catch (e) {
			console.error('Failed to parse environment config:', e);
			return {};
		}
	}

	var regList = deserializeEnvConfig('{"custom":{"__type":"Function","source":"(hostname) => {\\n            if (hostname.includes(\\"dev\\")) {\\n              return \\"development\\";\\n            } else if (hostname.includes(\\"sit\\")) {\\n              return \\"test\\";\\n            } else if (hostname.includes(\\"uat\\")) {\\n              return \\"uat\\";\\n            } else {\\n              return \\"production\\";\\n            }\\n          }"},"default":"production"}');

