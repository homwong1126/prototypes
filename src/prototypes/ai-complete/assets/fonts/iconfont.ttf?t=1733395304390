      }
    }

    // 根据域名判断环境
    function getCurrentEnvironment() {
      const hostname = window.location.hostname
      if (hostname.includes('dev') || hostname.includes('localhost')) {
        return 'development'
      } else if (hostname.includes('sit') || hostname.includes('test')) {
        return 'test'
      } else if (hostname.includes('uat')) {
        return 'uat'
      } else {
        return 'production'
      }
    }

    // 动态加载CSS
    function loadCSS(url, id) {
      return new Promise((resolve, reject) => {
        const existingLink = document.getElementById(id)
        if (existingLink) {
          resolve()
          return
        }

        const link = document.createElement('link')
        link.rel = 'stylesheet'
        link.type = 'text/css'
        link.href = url
        link.id = id

        link.onload = () => resolve()
        link.onerror = () => reject(new Error(`Failed to load CSS: ${url}`))

        document.head.appendChild(link)
      })
    }

    // 动态加载JS
    function loadJS(url, id) {
      return new Promise((resolve, reject) => {
        const existingScript = document.getElementById(id)
        if (existingScript) {
          resolve()
          return
        }

        const script = document.createElement('script')
        script.src = url
        script.id = id

        script.onload = () => resolve()
        script.onerror = () => reject(new Error(`Failed to load JS: ${url}`))

        document.head.appendChild(script)
      })
    }

    // 加载主题资源
    async function loadThemeResources() {
      try {
        const env = getCurrentEnvironment()
        const config = odinAIConfig[env]

        if (config) {
          // 并行加载CSS和JS
          await Promise.all([
            config.js ? loadJS(config.js, 'chery-gpt-sdk-js') : Promise.resolve()
          ])
          console.log(`AI SDK加载成功 (${env})`)
        }
      } catch (error) {
        console.error('AI SDK加载失败:', error)
      }
    }

    // 页面加载完成后立即加载主题资源
    loadThemeResources()
  </script>
